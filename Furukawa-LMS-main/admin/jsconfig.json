{
  "include": ["src/**/*"],
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@layouts/*": ["layouts/*"],
      "@pages/*": ["pages/*"],
      "@routes/*": ["routes/*"],
      "@store/*": ["store/*"],
      "@utils/*": ["utils/*"],
      "@config/*": ["config/*"],
      "@lib/*": ["lib/*"]
    }
  }
}